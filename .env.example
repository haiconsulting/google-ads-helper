# Names only. Values are set in the harness secret manager, not in this repo.

# Harness JWT verification (EdDSA JWKS document URL).
HARNESS_JWKS_URL=
# Expected token issuer. Defaults to hai-harness when unset.
HARNESS_ISSUER=
# Expected token audience. Defaults to google-ads-helper when unset.
HARNESS_CONNECTOR_ID=
# Harness internal API origin for accounts, secrets, and audit.
HARNESS_INTERNAL_URL=
# Optional. When set, requests must also send X-HAI-Local-Token (local connectors, spec §23).
HARNESS_LOCAL_TOKEN=
# Optional directory for persisted toggle state. Defaults to mcp/state.
HARNESS_STATE_DIR=

# Existing advisor route. Not read by the MCP connector.
ANTHROPIC_API_KEY=

# Optional. The site footer uses the package.json version when this is unset at build time.
NEXT_PUBLIC_APP_VERSION=
